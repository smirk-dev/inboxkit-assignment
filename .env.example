# PostgreSQL — matches docker-compose.yml defaults for local dev
DATABASE_URL=postgresql://tilewar:tilewar_dev@localhost:5432/tilewar

# Redis
REDIS_URL=redis://localhost:6379

# API server
PORT=4000
FRONTEND_URL=http://localhost:3000

# Frontend (must be prefixed NEXT_PUBLIC_ to be available in the browser)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Production overrides (Neon + Upstash TLS URLs go here)
# DATABASE_URL=postgresql://...neon.tech/tilewar?sslmode=require
# REDIS_URL=rediss://...upstash.io:6380
